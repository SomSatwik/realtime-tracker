# Example environment variables for Real-Time Tracker
# Default port the app will listen on
PORT=4000

# MongoDB connection string – replace <user>,<pwd>,<cluster>,<dbname>
MONGODB_URI=mongodb+srv://<user>:<pwd>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret for signing JWTs – use a strong random string
JWT_SECRET=your_jwt_secret_here
