<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.ghosttrack.app.ui.SplashFragment"
        android:label="SplashFragment">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ghosttrack.app.ui.HomeFragment"
        android:label="GhostTrack">
        <action
            android:id="@+id/action_home_to_share"
            app:destination="@id/shareFragment" />
        <action
            android:id="@+id/action_home_to_track"
            app:destination="@id/trackFragment" />
    </fragment>

    <fragment
        android:id="@+id/shareFragment"
        android:name="com.ghosttrack.app.ui.ShareFragment"
        android:label="Share Location" />

    <fragment
        android:id="@+id/trackFragment"
        android:name="com.ghosttrack.app.ui.TrackFragment"
        android:label="Track Location" />
</navigation>
