<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Driver Login</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container landing-page">
    <div class="card">
      <h1 class="title-text">Driver Login</h1>
      <% if (typeof error !== 'undefined') { %>
        <p style="color:red"><%= error %></p>
      <% } %>
      <form method="POST" action="/auth/driver/login">
        <div class="input-group">
          <label class="label-caps" for="email">Email</label>
          <input id="email" type="email" name="email" class="apple-input" required />
        </div>
        <div class="input-group">
          <label class="label-caps" for="password">Password</label>
          <input id="password" type="password" name="password" class="apple-input" required />
        </div>
        <button type="submit" class="btn-primary pressable">Login</button>
      </form>
      <p class="caption-text text-secondary" style="margin-top:12px;">New driver? <a href="/auth/driver/signup">Sign up</a></p>
    </div>
  </div>
</body>
</html>
